HOST=127.0.0.1
PORT=4000
# Set DATABASE_URL to the Neon pooled URL to use PostgreSQL.
# Leave blank for local SQLite development. Keep SSL parameters from Neon.
DATABASE_URL=
# Non-pooled URL used for migration and pg_dump backups.
DIRECT_DATABASE_URL=
ADMIN_ORIGIN=http://localhost:4000
# For frontend hot reload, use http://localhost:5173 instead.
# Optional absolute path to a compiled dashboard (default: ../frontend/dist).
# FRONTEND_DIST=/absolute/path/to/frontend/dist
APP_WEB_ORIGIN=http://localhost:8081
# Set this to the exact HTTPS gateway hostname when choosing an AI provider.
AI_ALLOWED_HOSTS=
# Direct fal integration: set key, then run npm run fal:setup.
FAL_KEY=
# Production: NODE_ENV=production, ADMIN_ORIGIN=https://admin.example.com
# TRUST_PROXY=1 only behind a trusted reverse proxy that overwrites forwarded headers.
# Set to 0 to pause generation workers and periodic billing reconciliation.
# BACKGROUND_WORKERS_ENABLED=0
# Render only: base64 of the EXISTING data/master.key, never a new random key.
# MASTER_KEY_BASE64=
# DATA_DIR=/tmp/ai-creator-data

# R2 stores image/video files only; the database remains separate.
# R2 is automatically selected when R2_BUCKET is set. Use MEDIA_STORAGE=local
# only for offline development; existing R2 objects still require R2 access.
# MEDIA_STORAGE=r2
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto

# Google Play Billing (see docs/GOOGLE-PLAY.md). Disabled until Console setup is complete.
PLAY_BILLING_ENABLED=0
PLAY_PACKAGE_NAME=com.aicreatorstudio.imagevideogenerator
GOOGLE_APPLICATION_CREDENTIALS=
PLAY_RTDN_AUDIENCE=
PLAY_RTDN_SERVICE_ACCOUNT=
